# Homebrew formula template for swaptop. `make brew-formula` fills in the
# version and the checksum of the GitHub source tarball and writes the
# result to bin/homebrew/swaptop.rb; copy that into your tap
# (github.com/andydixon/homebrew-tap, Formula/swaptop.rb).
class Swaptop < Formula
  desc "Htop-style view of which processes are using swap, and how"
  homepage "https://github.com/andydixon/swaptop"
  url "https://github.com/andydixon/swaptop/archive/refs/tags/v@VERSION@.tar.gz"
  sha256 "@SHA256@"
  license "GPL-3.0-or-later"
  head "https://github.com/andydixon/swaptop.git", branch: "master"

  depends_on "go" => :build
  depends_on :linux

  def install
    system "go", "build", *std_go_args(ldflags: "-s -w -X main.version=#{version}")
    man1.install "docs/swaptop.1"
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/swaptop --version")
  end
end
